# rm-pad config (TOML). Copy to rm-pad.toml or ~/.config/rm-pad.toml

host = "10.11.99.1"
# key_path = "~/.ssh/id_rsa"
# password = "your-root-password"

# touch_only = false
# pen_only = false
# grab_input = true   # on by default; set false to let tablet UI also see input
# no_palm_rejection = false
# palm_grace_ms = 500
# orientation = "landscape-right"
# screen = "0"        # screen to map the pen to: index, name, or "all" to span
                      # every screen; defaults to the primary screen when several
                      # are connected. List screens with: rm-pad screens
